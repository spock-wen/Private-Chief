// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  HOT_DISH    // 热菜
  COLD_DISH   // 凉菜
  SOUP        // 汤
  STAPLE      // 主食
  DRINK       // 饮料
}

enum TableStatus {
  PLANNING    // 筹备中
  VOTING      // 投票中
  LOCKED      // 已锁定
  ARCHIVED    // 已结束
}

enum FamilyMemberRole {
  OWNER       // 主人
  ADMIN       // 管理员
}

model Session {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  lastAccessed  DateTime @default(now())
  data          Json?    // Additional session data
  userId        String?  // Optional user ID if authenticated

  @@index([lastAccessed]) // Index for efficient cleanup of expired sessions
}

// 用户表（需要登录的管理者）
model User {
  id            String   @id @default(uuid())
  phone         String?  @unique  // 手机号
  email         String?  @unique  // 邮箱
  wechatOpenId  String?  @unique  // 微信OpenID
  nickname      String              // 昵称
  avatar        String?             // 头像
  password      String?             // 密码（如果用账号密码登录）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // 关联
  ownedFamilies    Family[]       @relation("FamilyOwner")
  familyMembers    FamilyMember[]
  createdTables    Table[]        @relation("TableCreator")
  createdDishes    Dish[]         @relation("DishCreator")
  tableGuests      Guest[]        @relation("GuestUser")
  
  @@index([phone])
  @@index([email])
  @@index([wechatOpenId])
}

// 家庭表
model Family {
  id            String   @id @default(uuid())
  name          String              // 家庭名称（如：张家、李家私厨）
  description   String?             // 家庭描述
  avatar        String?             // 家庭头像
  address       String?             // 默认地址
  addressDetail String?             // 详细地址
  latitude      Float?              // 纬度
  longitude     Float?              // 经度
  ownerId       String              // 主人ID
  owner         User     @relation("FamilyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // 关联
  members       FamilyMember[]
  invitations   FamilyInvitation[]
  dishes        Dish[]
  tables        Table[]
  
  @@index([ownerId])
}

// 家庭成员表（管理员）
model FamilyMember {
  id        String           @id @default(uuid())
  familyId  String
  family    Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      FamilyMemberRole @default(ADMIN)  // ADMIN 或 OWNER
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  
  @@unique([familyId, userId])  // 同一用户不能重复加入同一家庭
  @@index([userId])
  @@index([familyId])
}

// 家庭邀请表
model FamilyInvitation {
  id         String   @id @default(uuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  inviteCode String   @unique         // 邀请码（6位短码，如：ABC123）
  createdBy  String                   // 创建邀请的用户ID
  expiresAt  DateTime                 // 过期时间（如：7天后）
  maxUses    Int      @default(1)     // 最大使用次数（-1表示无限制）
  usedCount  Int      @default(0)     // 已使用次数
  createdAt  DateTime @default(now())
  
  // 关联
  usages     InvitationUsage[]
  
  @@index([inviteCode])
  @@index([familyId])
}

// 邀请使用记录
model InvitationUsage {
  id           String           @id @default(uuid())
  invitationId String
  invitation   FamilyInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  userId       String           // 使用者的用户ID
  usedAt       DateTime         @default(now())
  
  @@index([invitationId])
  @@index([userId])
}

model Dish {
  id          String   @id @default(uuid())
  name        String
  description String?
  image       String?
  category    Category
  tags        String[] // 口味标签
  allergens   String?  // 过敏原文本
  familyId    String   // 所属家庭
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   String   // 创建者用户ID
  creator     User     @relation("DishCreator", fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联
  tablesAsCandidate Table[] @relation("CandidateDishes")
  tablesAsFinal     Table[] @relation("FinalDishes")
  votes             Vote[]
  
  @@index([familyId])
  @@index([createdBy])
}

model Table {
  id            String      @id @default(uuid())
  name          String
  time          DateTime
  location      String?     // 饭桌地点（文本描述）
  address       String?     // 详细地址
  addressDetail String?     // 地址补充信息
  latitude      Float?      // 纬度
  longitude     Float?      // 经度
  status        TableStatus @default(PLANNING)
  totalExpense  Float?      // 总支出
  familyId      String      // 所属家庭
  family        Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creatorId     String      // 创建者用户ID（必须是家庭成员）
  creator       User        @relation("TableCreator", fields: [creatorId], references: [id])
  finalDishIds  String[]    @default([])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // 关联
  candidateDishes Dish[]  @relation("CandidateDishes")
  finalDishes     Dish[]  @relation("FinalDishes")
  guests          Guest[]
  votes           Vote[]
  
  @@index([familyId])
  @@index([creatorId])
}

model Guest {
  id          String   @id @default(uuid())
  sessionId   String   // 用于 Browser Session 标记匿名身份
  name        String
  preferences String?  // 忌口/偏好
  userId      String?  // 已登录用户的 ID，用于多设备合并
  user        User?    @relation("GuestUser", fields: [userId], references: [id], onDelete: SetNull)
  tableId     String
  table       Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  votes       Vote[]
  createdAt   DateTime @default(now())

  @@unique([sessionId, tableId])  // 同一会话在同一饭桌只能有一个身份
  @@index([sessionId])
  @@index([tableId])
  @@index([tableId, userId])  // 按 userId 查找
}

model Vote {
  id        String   @id @default(uuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([guestId, dishId, tableId])
  @@index([tableId])
  @@index([dishId])
}
